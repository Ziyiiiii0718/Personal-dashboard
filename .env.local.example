# Anthropic API key — required for the AI diet features (meal parsing + label scanning).
# Get one at https://console.anthropic.com/ then copy this file to ".env.local".
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Password required to use the AI features, so strangers can't spend your API credit.
# Pick a long, random value. The AI routes refuse every request until this is set.
AI_ACCESS_PASSWORD=change-me-to-something-long-and-random

# Optional: override the model (defaults to claude-sonnet-4-6).
# ANTHROPIC_MODEL=claude-sonnet-4-6
